# ---------- Required ----------
# The customer's domain, without https:// (point its A record at this server first)
DOMAIN=bookings.example.com
# Email for the free HTTPS certificate (Let's Encrypt expiry notices)
ACME_EMAIL=you@example.com
# Database password: long and random (scripts/install.sh fills this in)
DB_PASSWORD=change-me
# Signs staff logins: at least 32 random characters (scripts/install.sh fills this in)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# First admin login, created on the first start only
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-now
# Starting preset on first start: dubai | london | chennai | generic (everything is editable later)
REGION=generic
# Load demo drivers, vehicles and bookings (only for demos)
SEED_DEMO=false

# ---------- Card payments (optional) ----------
# none | razorpay (India) | stripe (international)
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# ---------- Email (optional, recommended) ----------
# Any SMTP service: Zoho Mail, Google Workspace, Brevo, Resend, Amazon SES...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Company Name <bookings@example.com>"

# ---------- Distances (optional) ----------
# Google Routes API key. Without it, distances come from saved places' coordinates.
GOOGLE_MAPS_API_KEY=
